DirectoryIndex index.php

# Empêche l'accès direct à l'éditeur brut et aux fichiers sensibles :
# tout doit passer par index.php (qui vérifie la session).
<FilesMatch "^(editor\.html|\.auth\.php|config\.php|_shell\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Ceinture supplémentaire : aucun .php.tmp_* ou fichier caché type .auth.php ne doit fuiter.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>

Options -Indexes
